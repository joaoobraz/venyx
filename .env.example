# Public Supabase configuration (safe to expose to the browser).
SUPABASE_PROJECT_ID=YOUR_PRODUCTION_PROJECT_ID
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=YOUR_PRODUCTION_PROJECT_ID
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile site key (public). Enable the same provider in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

# Investor presentation mode. It is enabled by default only in local development.
# To enable it in a dedicated preview deployment, set both flags to true.
VITE_APP_ENV=production
VITE_ENABLE_DEMO_CREATORS=false
VITE_ENABLE_DEMO_PREVIEW=false
VITE_ENABLE_LOCAL_PREVIEW_ACCESS=false
VITE_DEMO_PREVIEW_EMAILS=joaobraz.ofc@gmail.com
VITE_PUBLIC_SITE_DOMAIN=Fanlira.com.br
VITE_LEGAL_ENTITY_NAME=YOUR_LEGAL_ENTITY_NAME
VITE_LEGAL_ENTITY_DOCUMENT=YOUR_CNPJ_OR_LEGAL_DOCUMENT
VITE_LEGAL_ENTITY_ADDRESS=YOUR_REGISTERED_BUSINESS_ADDRESS
VITE_SUPPORT_EMAIL=suporte@fanlira.com.br
VITE_PRIVACY_EMAIL=privacidade@fanlira.com.br
VITE_ABUSE_EMAIL=seguranca@fanlira.com.br
VITE_DMCA_EMAIL=privacidade@fanlira.com.br

# Enable only in the Cloudflare deployment job. Local/Node builds leave it false.
CLOUDFLARE_BUILD=false

# Server-only secrets. Never prefix these variables with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string used only by the offline backup command.
SUPABASE_DB_URL=
IMPULSEPAY_PUBLIC_KEY=
IMPULSEPAY_SECRET_KEY=
IMPULSEPAY_WITHDRAWAL_KEY=
# Segredo próprio da Fanlira incluído na URL do webhook. Gere um valor longo e aleatório.
IMPULSEPAY_WEBHOOK_TOKEN=
# No painel Impulse Pay, cadastre esta URL acrescida de ?token=O_MESMO_SEGREDO_ACIMA.
IMPULSEPAY_WEBHOOK_URL=https://fanlira.com.br/api/public/impulsepay-webhook
CRON_SECRET=
# Optional generic webhook that receives only sanitized high/critical operational alerts.
OPERATIONS_ALERT_WEBHOOK_URL=

# AI provider compatible with the OpenAI Chat Completions request/response shape.
# Example endpoint: https://api.openai.com/v1/chat/completions
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Comma-separated browser origins allowed to call Supabase Edge Functions.
# Example: https://staging.fanlira.com.br,https://fanlira.com.br
ALLOWED_ORIGINS=https://fanlira.com.br,https://www.fanlira.com.br

# Keep payment test endpoints disabled outside a controlled local environment.
ENABLE_PAYMENT_TEST_ENDPOINTS=false

# Temporary local-only escape hatch while a real identity provider is integrated.
# Production always rejects checksum-only age verification.
ALLOW_INSECURE_AGE_CHECK=false

# Reserved for the future identity provider integration.
CPF_LOOKUP_API_KEY=
