# Public Supabase configuration (safe to expose to the browser).
SUPABASE_PROJECT_ID=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these variables with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
NEXUSPAG_API_KEY=
PUBLIC_WEBHOOK_URL=https://YOUR_DOMAIN/api/public/nexuspag-webhook
CRON_SECRET=

# Keep payment test endpoints disabled outside a controlled local environment.
ENABLE_PAYMENT_TEST_ENDPOINTS=false

# Temporary local-only escape hatch while a real identity provider is integrated.
# Production always rejects checksum-only age verification.
ALLOW_INSECURE_AGE_CHECK=false

# Reserved for the future identity provider integration.
CPF_LOOKUP_API_KEY=
