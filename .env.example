# Public Supabase configuration (safe to expose to the browser).
SUPABASE_PROJECT_ID=uzbdzklsufweldmfbvfq
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=uzbdzklsufweldmfbvfq
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these variables with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
NEXUSPAG_API_KEY=
NEXUSPAG_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=https://YOUR_DOMAIN/api/public/nexuspag-webhook
CRON_SECRET=

# AI provider compatible with the OpenAI Chat Completions request/response shape.
# Example endpoint: https://api.openai.com/v1/chat/completions
AI_CHAT_COMPLETIONS_URL=
AI_API_KEY=
AI_TEXT_MODEL=
AI_VISION_MODEL=

# Comma-separated browser origins allowed to call Supabase Edge Functions.
# Example: https://staging.venyx.com,https://venyx.com
ALLOWED_ORIGINS=http://localhost:8080

# Keep payment test endpoints disabled outside a controlled local environment.
ENABLE_PAYMENT_TEST_ENDPOINTS=false

# Temporary local-only escape hatch while a real identity provider is integrated.
# Production always rejects checksum-only age verification.
ALLOW_INSECURE_AGE_CHECK=false

# Reserved for the future identity provider integration.
CPF_LOOKUP_API_KEY=
